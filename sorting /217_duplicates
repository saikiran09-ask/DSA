import java.util.HashSet;

class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> set = new HashSet<>();
        
        for (int i : nums) {
            // .add() returns false if the item already exists in the set
            if (!set.add(i)) {
                return true; 
            }
        }
        
        return false;
    }
}
