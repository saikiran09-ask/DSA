import java.util.Scanner;
class Main {
   public static void main(String[] args) {
     // Wirte your code here
     Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    int m = sc.nextInt();
    int arr[]=new int[n+m];
    for(int i=0;i<n+m;i++){
        arr[i]=sc.nextInt();
    }
    for(int i=0;i<n+m;i++){
        for(int j=i+1;j<n+m;j++){
            if(arr[i]>arr[j]){
                int temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
            }
        }
    }
    for(int i=0;i<n+m;i++){
        System.out.print(arr[i]+" ");
    }
   }
}
